# ===========================================================
# Variables de entorno para el proyecto ETL Vuelos
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ===========================================================

# Conexión a SQL Server (Docker local)
DB_SERVER=localhost,1433
DB_NAME=VuelosDW
DB_USER=sa
DB_PASSWORD=TuPasswordSegura123!
DB_DRIVER=ODBC Driver 18 for SQL Server

# Ruta al dataset crudo (relativa a la raíz del proyecto)
RAW_DATA_PATH=dataset_vuelos_crudo.csv

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
