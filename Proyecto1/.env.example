# ==============================================================================
# Variables de Entorno — Proyecto 1: SG-Food Modern Data Stack
# ==============================================================================

# Configuración de Base de Datos PostgreSQL (Data Warehouse & OLTP)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sgfood_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Configuración de Apache Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=sgfood_secret_key_airflow_2026
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Guatemala

# Configuración dbt
DBT_PROFILES_DIR=/opt/airflow/dbt_sgfood
DBT_PROJECT_DIR=/opt/airflow/dbt_sgfood
