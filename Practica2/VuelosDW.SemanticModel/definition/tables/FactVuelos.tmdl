/// Tabla de Hechos — Un registro por vuelo reservado/realizado
/// Contiene las métricas de negocio y las medidas DAX analíticas
table FactVuelos
	lineageTag: b0000007-0000-0000-0000-000000000001

	column id_vuelo
		dataType: int64
		isHidden
		isKey
		isNullable: false
		sourceColumn: id_vuelo
		summarizeBy: none
		lineageTag: b0000007-0001-0000-0000-000000000001

	column id_fecha
		dataType: int64
		isHidden
		sourceColumn: id_fecha
		summarizeBy: none
		lineageTag: b0000007-0002-0000-0000-000000000001

	column id_pasajero
		dataType: int64
		isHidden
		sourceColumn: id_pasajero
		summarizeBy: none
		lineageTag: b0000007-0003-0000-0000-000000000001

	column id_aerolinea
		dataType: int64
		isHidden
		sourceColumn: id_aerolinea
		summarizeBy: none
		lineageTag: b0000007-0004-0000-0000-000000000001

	column id_origen
		dataType: int64
		isHidden
		sourceColumn: id_origen
		summarizeBy: none
		lineageTag: b0000007-0005-0000-0000-000000000001

	column id_destino
		dataType: int64
		isHidden
		sourceColumn: id_destino
		summarizeBy: none
		lineageTag: b0000007-0006-0000-0000-000000000001

	column id_clase
		dataType: int64
		isHidden
		sourceColumn: id_clase
		summarizeBy: none
		lineageTag: b0000007-0007-0000-0000-000000000001

	column id_estado
		dataType: int64
		isHidden
		sourceColumn: id_estado
		summarizeBy: none
		lineageTag: b0000007-0008-0000-0000-000000000001

	column numero_vuelo
		dataType: string
		sourceColumn: numero_vuelo
		summarizeBy: none
		lineageTag: b0000007-0009-0000-0000-000000000001

	column duracion_minutos
		dataType: int64
		sourceColumn: duracion_minutos
		summarizeBy: sum
		lineageTag: b0000007-000a-0000-0000-000000000001

	column precio_usd
		dataType: decimal
		sourceColumn: precio_usd
		formatString: $ #,##0.00
		summarizeBy: sum
		lineageTag: b0000007-000b-0000-0000-000000000001

	column retraso_minutos
		dataType: int64
		sourceColumn: retraso_minutos
		summarizeBy: sum
		lineageTag: b0000007-000c-0000-0000-000000000001

	column total_equipaje
		dataType: int64
		sourceColumn: total_equipaje
		summarizeBy: sum
		lineageTag: b0000007-000d-0000-0000-000000000001

	column canal_venta
		dataType: string
		sourceColumn: canal_venta
		summarizeBy: none
		lineageTag: b0000007-000e-0000-0000-000000000001

	column metodo_pago
		dataType: string
		sourceColumn: metodo_pago
		summarizeBy: none
		lineageTag: b0000007-000f-0000-0000-000000000001

	/// ============================================================
	/// MEDIDAS DAX — Indicadores clave de desempeño (KPIs)
	/// ============================================================

	/// Total de vuelos registrados en el sistema
	measure 'Total Vuelos' = COUNTROWS(FactVuelos)
		formatString: #,##0
		displayFolder: Métricas Principales
		lineageTag: c0000001-0000-0000-0000-000000000001

	/// Ingresos totales por venta de boletos en USD
	measure 'Ingresos Totales USD' = SUM(FactVuelos[precio_usd])
		formatString: $ #,##0.00
		displayFolder: Métricas Principales
		lineageTag: c0000002-0000-0000-0000-000000000001

	/// Precio promedio de un boleto en USD
	measure 'Precio Promedio USD' = AVERAGE(FactVuelos[precio_usd])
		formatString: $ #,##0.00
		displayFolder: Métricas Principales
		lineageTag: c0000003-0000-0000-0000-000000000001

	/// Retraso promedio de vuelos en minutos
	measure 'Retraso Promedio Min' = AVERAGE(FactVuelos[retraso_minutos])
		formatString: #,##0.0
		displayFolder: Métricas Principales
		lineageTag: c0000004-0000-0000-0000-000000000001

	/// Total de vuelos con estado CANCELLED
	measure 'Vuelos Cancelados' =
			CALCULATE(
			    COUNTROWS(FactVuelos),
			    DimEstado[estado_vuelo] = "CANCELLED"
			)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: c0000005-0000-0000-0000-000000000001

	/// KPI: Tasa de cancelación como porcentaje del total
	/// Semáforo: Verde ≤5% | Amarillo ≤10% | Rojo >10%
	measure 'Tasa Cancelación %' =
			DIVIDE(
			    [Vuelos Cancelados],
			    [Total Vuelos],
			    0
			) * 100
		formatString: #,##0.00"%"
		displayFolder: KPIs
		lineageTag: c0000006-0000-0000-0000-000000000001

	/// DAX Avanzada: Crecimiento mes a mes en volumen de vuelos
	measure 'Crecimiento MoM %' =
			VAR VuelosMesActual = [Total Vuelos]
			VAR VuelosMesAnterior =
			    CALCULATE(
			        [Total Vuelos],
			        DATEADD(DimFecha[fecha], -1, MONTH)
			    )
			RETURN
			    IF(
			        ISBLANK(VuelosMesAnterior),
			        BLANK(),
			        DIVIDE(
			            VuelosMesActual - VuelosMesAnterior,
			            VuelosMesAnterior,
			            0
			        ) * 100
			    )
		formatString: +#,##0.0"%";-#,##0.0"%";#,##0.0"%"
		displayFolder: KPIs
		lineageTag: c0000007-0000-0000-0000-000000000001

	/// Ingreso promedio generado por cada pasajero único
	measure 'Ingreso por Pasajero' =
			DIVIDE(
			    [Ingresos Totales USD],
			    DISTINCTCOUNT(FactVuelos[id_pasajero]),
			    0
			)
		formatString: $ #,##0.00
		displayFolder: Métricas Principales
		lineageTag: c0000008-0000-0000-0000-000000000001

	/// Pasajeros únicos que realizaron al menos un vuelo
	measure 'Pasajeros Únicos' = DISTINCTCOUNT(FactVuelos[id_pasajero])
		formatString: #,##0
		displayFolder: Métricas Principales
		lineageTag: c0000009-0000-0000-0000-000000000001

	/// KPI Semáforo: Indicador visual para la tasa de cancelación
	/// Verde (1) = ≤5% | Amarillo (2) = ≤10% | Rojo (3) = >10%
	measure 'Semáforo Cancelación' =
			VAR Tasa = [Tasa Cancelación %]
			RETURN
			    SWITCH(
			        TRUE(),
			        Tasa <= 5, 1,
			        Tasa <= 10, 2,
			        3
			    )
		formatString: 0
		displayFolder: KPIs
		lineageTag: c000000a-0000-0000-0000-000000000001

	partition FactVuelos = m
		mode: import
		source =
			let
			    Origen = Sql.Database("localhost,1433", "VuelosDW"),
			    dbo_FactVuelos = Origen{[Schema="dbo",Item="FactVuelos"]}[Data]
			in
			    dbo_FactVuelos
