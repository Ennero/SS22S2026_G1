model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX

	ref table DimFecha
	ref table DimPasajero
	ref table DimAerolinea
	ref table DimAeropuerto
	ref table DimClase
	ref table DimEstado
	ref table FactVuelos

expression ServerConnection =
		"localhost,1433" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: a0000001-0000-0000-0000-000000000001

expression DatabaseName =
		"VuelosDW" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: a0000001-0000-0000-0000-000000000002
