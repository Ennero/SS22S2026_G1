{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "line_temporal",
  "position": {
    "x": 440,
    "y": 160,
    "width": 540,
    "height": 280,
    "z": 5
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "DimFecha" }
                  },
                  "Property": "fecha"
                }
              },
              "queryRef": "DimFecha.fecha",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": { "Entity": "FactVuelos" }
                  },
                  "Property": "Total Vuelos"
                }
              },
              "queryRef": "FactVuelos.Total Vuelos",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": { "Entity": "FactVuelos" }
                  },
                  "Property": "Ingresos Totales USD"
                }
              },
              "queryRef": "FactVuelos.Ingresos Totales USD",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Tendencia Temporal — Vuelos e Ingresos'" } } }
          }
        }
      ]
    }
  }
}
