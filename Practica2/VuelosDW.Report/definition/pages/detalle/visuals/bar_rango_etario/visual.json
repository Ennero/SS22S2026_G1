{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar_rango_etario",
  "position": {
    "x": 640,
    "y": 20,
    "width": 380,
    "height": 320,
    "z": 2
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "DimPasajero" }
                  },
                  "Property": "rango_etario"
                }
              },
              "queryRef": "DimPasajero.rango_etario",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": { "Entity": "FactVuelos" }
                  },
                  "Property": "Total Vuelos"
                }
              },
              "queryRef": "FactVuelos.Total Vuelos",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "DimClase" }
                  },
                  "Property": "clase_cabina"
                }
              },
              "queryRef": "DimClase.clase_cabina",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Distribución por Rango Etario y Clase'" } } }
          }
        }
      ]
    }
  }
}
