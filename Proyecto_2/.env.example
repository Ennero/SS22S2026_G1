# =====================================================================
# VARIABLES DE CONFIGURACIÓN - PROYECTO 2: SEMINARIO DE SISTEMAS 2
# =====================================================================

# 1. Configuración de Google Cloud Platform (GCP)
# ID del proyecto en GCP donde tienes habilitado BigQuery
GCP_PROJECT_ID=tu-id-de-proyecto-gcp

# Nombre del dataset en BigQuery donde se crearán las tablas y modelos
GCP_DATASET_ID=nyc_taxi_dw

# Región geográfica del dataset (US multi-región requerida por el dataset público)
GCP_LOCATION=US

# Ruta absoluta o relativa al archivo JSON con la clave de la Cuenta de Servicio
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/gcp_credentials.json

# 2. Configuración de PostgreSQL para Metadatos de Apache Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow_db
POSTGRES_PORT=5432

# 3. Configuración del Servidor Web de Apache Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@seminario2.usac.edu.gt
AIRFLOW__WEBSERVER__SECRET_KEY=proyecto2_secret_key_airflow_bigquery_2026
